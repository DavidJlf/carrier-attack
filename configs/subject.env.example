# Copy to configs/subject.env and set paths for the run.
PYTHON_BIN=python
ACCELERATE_BIN=accelerate
SAM_PYTHON=python
FLUX_MODEL=black-forest-labs/FLUX.1-Kontext-dev
FLUX_LORA_TRAINER=/absolute/path/to/diffusers/examples/dreambooth/train_dreambooth_lora_flux.py

# Subject inputs and output paths.
REFERENCE_DIR=data/dreambooth_references/subject_name
LORA_OUTPUT_DIR=/absolute/path/to/loras/subject_name
LORA_WEIGHTS=/absolute/path/to/loras/subject_name/pytorch_lora_weights.safetensors
SUBJECT_SAMPLE_DIR=/absolute/path/to/subject_samples/subject_name

CONCEPT_TOKEN=[V]
SUBJECT=subject_name
INSTANCE_PROMPT=[V] subject_name
SAMPLE_PROMPT=a high quality photograph of [V] subject_name, one subject, centered, sharp focus
SOURCE_IMAGE=/absolute/path/to/selected/subject_sample.png
SOURCE_CLASSES=0

TARGET_LABEL=target_class_name
TARGET_CLASS=0
VISIBLE_CARRIER=auto
VISIBLE_CARRIER_CLASS=auto
OUTPUT_ROOT=/absolute/path/to/outputs
RUN_NAME=example_subject_to_target
METHODS=cra,jia,cira
DINO_MODEL=/absolute/path/to/DINOv3-ViT-L-16
SAM3_CHECKPOINT=/absolute/path/to/sam3.pt
SAM3_REPO=/absolute/path/to/sam3/repo
QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
SEED=0
EXECUTE=0
