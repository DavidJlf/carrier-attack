# Copy to configs/subject.env. Never commit the filled file.
PYTHON_BIN=python
ACCELERATE_BIN=accelerate
FLUX_MODEL=black-forest-labs/FLUX.1-Kontext-dev
FLUX_LORA_TRAINER=/absolute/path/to/diffusers/examples/dreambooth/train_dreambooth_lora_flux.py

# Private local assets. Create one local config for each of the 20 subjects.
REFERENCE_DIR=/absolute/path/to/private/dreambooth_references/subject_01
LORA_OUTPUT_DIR=/absolute/path/to/private/loras/subject_01
LORA_WEIGHTS=/absolute/path/to/private/loras/subject_01/pytorch_lora_weights.safetensors
SUBJECT_SAMPLE_DIR=/absolute/path/to/private/subject_samples/subject_01

CONCEPT_TOKEN=[V]
SUBJECT=subject_class
INSTANCE_PROMPT=[V] subject_class
SAMPLE_PROMPT=a high quality photograph of [V] subject_class, one subject, centered, sharp focus
SOURCE_IMAGE=/absolute/path/to/selected/subject_sample.png
SOURCE_CLASSES=0

TARGET_LABEL=ambulance
TARGET_CLASS=407
VISIBLE_CARRIER=ambulance
OUTPUT_ROOT=/absolute/path/to/private/outputs
METHODS=cra,jia,cira
SEED=0
EXECUTE=0
